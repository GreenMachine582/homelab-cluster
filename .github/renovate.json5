// Renovate (GitHub App): PRs for the Helm charts (Flux HelmReleases), Flux's
// own manifests, the images in apps/ and infrastructure/, and GitHub Actions.
// Minor, patch and digest updates automerge once a release is 3 days old, on
// weekday working hours, Sydney time, and Flux rolls them out; majors and 0.x
// wait for review. Images are pinned by tag and digest, so a re-pushed tag
// can't change what runs. See CONTRIBUTING.md.
//
// Held versions are still tracked, but capped with allowedVersions, so only a
// PR lifting the cap moves them; inside the cap they still wait for Dependency
// Dashboard approval. Each rule says why it's held.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":dependencyDashboard"],
  timezone: "Australia/Sydney",
  // build(deps): ..., the type CONTRIBUTING.md uses for chart and image
  // versions; passes commit-style.
  semanticCommits: "enabled",
  semanticCommitType: "build",
  semanticCommitScope: "deps",
  // Commits through the GitHub API, signed by GitHub: main requires signatures.
  platformCommit: "enabled",
  minimumReleaseAge: "3 days",
  enabledManagers: ["flux", "kubernetes", "github-actions"],
  flux: {
    managerFilePatterns: [
      "/^(apps|infrastructure)/.+\\.ya?ml$/",
      "/^clusters/prod/flux-system/gotk-components\\.yaml$/",
    ],
  },
  kubernetes: {
    managerFilePatterns: ["/^(apps|infrastructure)/.+\\.ya?ml$/"],
    pinDigests: true,
  },
  packageRules: [
    {
      description: "Automerge minor, patch and digest updates, except 0.x (where a minor can break)",
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      matchCurrentVersion: "!/^v?0\\./",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      automergeSchedule: ["* 9-16 * * 1-5"],
    },
    {
      description: "Our own release tags, smoke-tested by greentechhub-ui's CI: automerge 0.x minors too, no wait. dev, sha-* and latest aren't versions, so they're never offered.",
      matchDepNames: ["ghcr.io/greenmachine582/greentechhub-ui-playground"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "0 days",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      automergeSchedule: ["* 9-16 * * 1-5"],
    },
    {
      description: "Held at 1.20.1: 1.20.2 loads socket-LB programs that need kernel BTF, which the Raspberry Pi OS kernels lack. See the HelmRelease header. Lift the cap in a PR (with HomeLab's) once they have it.",
      matchDepNames: ["cilium"],
      allowedVersions: "<=1.20.1",
      dependencyDashboardApproval: true,
      automerge: false,
      prBodyNotes: [
        "Held for kernel BTF. Before merging: `/sys/kernel/btf/vmlinux` exists on the Pis, or the release notes say socket LB works without it. Bump HomeLab's `cilium_version` (the fresh-install seed) in a matching PR.",
      ],
    },
    {
      description: "Flux itself: the controller CLI version must match",
      matchDepNames: ["fluxcd/flux2"],
      automerge: false,
      prBodyNotes: [
        "Bump HomeLab's `flux_version` in a matching PR (Renovate opens it there), then run `controller.yml -K` for the CLI.",
      ],
    },
    {
      description: "HomeLab's cloudflared_version (the controller's CLI) follows this image",
      matchDepNames: ["cloudflare/cloudflared"],
      prBodyNotes: [
        "Renovate opens the matching `cloudflared_version` PR in HomeLab; its checksums are filled in by a workflow there.",
      ],
    },
  ],
}
